PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_MULTIMODAL_FALLBACK_MODEL=gemini-3-flash-preview
GEMINI_SPEECH_MODEL=gemini-2.5-flash-preview-tts
# One total deadline reserves two model attempts plus queue/backoff overhead.
AI_REQUEST_TIMEOUT_MS=45000
AI_ATTEMPT_TIMEOUT_MS=18000
# Shared across the listed AI routes; fixed 24h window per running server.
AI_DAILY_LIMIT_PER_IP=200
AI_DAILY_LIMIT_PER_SESSION=100
# Optional integrations. Keep secret values server-side.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
YOUTUBE_OAUTH_TOKEN=
BRAVE_SEARCH_API_KEY=
# Denoising is opt-in because it may remove thin formula strokes.
OCR_DENOISE=false
